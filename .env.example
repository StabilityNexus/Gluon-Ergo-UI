# The deployment this site serves (from the SDK's DEPLOYMENTS).
NEXT_PUBLIC_GLUON_DEPLOYMENT=gluon-gold-v3

# Ergo node with CORS enabled.
NEXT_PUBLIC_NODE_URL=https://node.sigmaspace.io

# The site's public URL (must be an absolute URL that includes the base path and a trailing slash).
# NEXT_PUBLIC_SITE_URL=https://example.org/

# Optional.
# NEXT_PUBLIC_BASE_PATH=/Gluon-Ergo-UI-Gold
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.ergoplatform.com
# NEXT_PUBLIC_EXPLORER_API_URL=https://api.ergoplatform.com/api/v1
# NEXT_PUBLIC_YIELD_CHART_MIN_APY=
